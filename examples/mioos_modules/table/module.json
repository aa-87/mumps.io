{
  "id": "user.table.example",
  "key": "user.table.example",
  "appKey": "user.table.example",
  "title": "Table Example",
  "description": "MUMPS-first example module using the Advanced Backend Table contract and ROI 68A sample matrix.",
  "source": "user",
  "category": "Examples",
  "icon": "▤",
  "componentKey": "table",
  "surface": "mioos-surface-table",
  "config": {
    "dataset": "demo",
    "contract": "mioos-advanced-table-v8",
    "defaultPageSize": 25,
    "density": "compact",
    "transport": "websocket",
    "mutateTransport": "websocket",
    "actionsWidth": 156,
    "defaultSort": {
      "column": "name",
      "direction": "ascending"
    },
    "features": {
      "search": true,
      "filters": true,
      "grouping": true,
      "columnPicker": true,
      "rowCrud": true,
      "columnCrud": true,
      "selection": true,
      "bulkActions": true,
      "pagination": true,
      "rowDetails": true,
      "resizeColumns": true,
      "cellEditing": true,
      "columnReorder": true,
      "fixedColumns": true,
      "advancedFilters": true
    },
    "fixedColumns": {
      "start": 1,
      "end": 0
    },
    "sampleMatrix": [
      {
        "key": "basic-readonly",
        "title": "Basic read-only table",
        "file": "samples/basic_readonly.m"
      },
      {
        "key": "editable-cells",
        "title": "Editable cells and callbacks",
        "file": "samples/editable_cells.m"
      },
      {
        "key": "validation-rules",
        "title": "Validation rules",
        "file": "samples/validation_rules.m"
      },
      {
        "key": "advanced-filters",
        "title": "Advanced filters",
        "file": "samples/advanced_filters.m"
      },
      {
        "key": "grouping-reorder-fixed",
        "title": "Grouping, reorder, fixed columns",
        "file": "samples/grouping_reorder_fixed.m"
      },
      {
        "key": "server-csv-export",
        "title": "Selected-row server CSV export",
        "file": "samples/server_csv_export.m"
      },
      {
        "key": "module-registration",
        "title": "Table-backed module registration",
        "file": "samples/table_module_registration.m"
      }
    ]
  }
}
