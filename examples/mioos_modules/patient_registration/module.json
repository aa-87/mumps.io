{
  "id": "mioos.ui.patient.registration",
  "key": "patient-registration",
  "appKey": "patient-registration",
  "title": "Patient Registration",
  "componentKey": "table",
  "surface": "mioos-surface-table",
  "category": "Healthcare",
  "description": "Synthetic patient registration intake workflow backed by MIOOSTBL and MIOOSPAT server-side validation, duplicate warnings, status transitions, and audit helpers.",
  "tableState": {
    "id": "patient-registration-table",
    "title": "Patient Registration",
    "dataset": "patient-registration",
    "config": {
      "contract": "mioos-advanced-table-v8",
      "defaultPageSize": 25,
      "defaultSort": {
        "column": "lastName",
        "direction": "ascending"
      },
      "features": {
        "rowCrud": true,
        "cellEditing": true,
        "filters": true,
        "grouping": true,
        "selection": true,
        "bulkActions": true,
        "columnReorder": true,
        "fixedColumns": true,
        "rowDetails": true
      },
      "fixedColumns": {
        "start": 1,
        "end": 0
      }
    }
  },
  "capabilities": {
    "patientRegistration": true,
    "auditStatus": true,
    "hipaaReadyArchitectureOnly": true,
    "intakeWorkflow": true,
    "duplicateDetection": true,
    "statusTransitions": true,
    "validationSummary": true
  },
  "features": {
    "importExport": true,
    "reconciliation": true
  },
  "actions": [
    {
      "key": "patient.import.preview",
      "label": "Preview patient CSV import"
    },
    {
      "key": "patient.import.commit",
      "label": "Commit valid patient CSV rows"
    },
    {
      "key": "patient.reconcile.report",
      "label": "Run patient reconciliation report"
    }
  ]
}
