# /etc/mumps-io/mws.env
# Environment template for MUMPS.IO (MIO) on YottaDB.
#
# IMPORTANT: set these to match your YottaDB installation and your database layout.

# Path to YottaDB distribution (example)
ydb_dist=/usr/local/lib/yottadb/r202

# Database/global directory (example)
ydb_dir=/var/lib/mumps-io/ydb

# Global directory file (*.gld)
ydb_gbldir=/var/lib/mumps-io/ydb/mws.gld

# Routine search path — include your backend routines directory
# Example (adjust):
gtmroutines=/opt/mumps.io/MIO/backend/routines

# Config file for the server
MWS_CONF=/etc/mumps-io/mws.conf.json

# Optional: tune process environment
# ydb_log=/var/log/mumps-io/ydb.log
# ydb_rel=1
